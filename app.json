{
  "expo": {
    "name": "Undertone",
    "slug": "undertone",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddkufe.undertone",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ddkufe.undertone"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0e1115",
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
