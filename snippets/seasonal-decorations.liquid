<!-- snippets/seasonal-decorations.liquid
     Ambient glowing jack-o'-lanterns + wisp ghosts. Non-interactive
     (pointer-events: none) so they never sit between a shopper and a tap
     target, and motion is dropped under prefers-reduced-motion. Toggle
     off any time from Theme settings > Seasonal (Halloween / Fall). -->
{% if settings.enable_seasonal_decorations %}
<div class="seasonal-decor" aria-hidden="true">

  <svg class="seasonal-pumpkin seasonal-pumpkin--a" viewBox="0 0 120 120" width="72" height="72">
    <defs>
      <radialGradient id="pg-a" cx="50%" cy="40%" r="65%">
        <stop offset="0%" stop-color="#FF9E4A"/>
        <stop offset="100%" stop-color="#E4530C"/>
      </radialGradient>
    </defs>
    <ellipse cx="60" cy="68" rx="44" ry="34" fill="url(#pg-a)"/>
    <path d="M22 68c0-19 5-34 10-34M60 68c0-21 0-38 0-38M98 68c0-19-5-34-10-34" stroke="#B33E09" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.55"/>
    <rect x="55" y="14" width="10" height="18" rx="4" fill="#5B7A4A"/>
    <path d="M40 62l7 8 7-8M66 62l7 8 7-8" stroke="#2B1206" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M40 84c6 6 34 6 40 0" stroke="#2B1206" stroke-width="4" fill="none" stroke-linecap="round"/>
  </svg>

  <svg class="seasonal-pumpkin seasonal-pumpkin--b" viewBox="0 0 120 120" width="46" height="46">
    <defs>
      <radialGradient id="pg-b" cx="50%" cy="40%" r="65%">
        <stop offset="0%" stop-color="#B888F0"/>
        <stop offset="100%" stop-color="#7C4FD1"/>
      </radialGradient>
    </defs>
    <ellipse cx="60" cy="68" rx="44" ry="34" fill="url(#pg-b)"/>
    <rect x="55" y="14" width="10" height="18" rx="4" fill="#5B7A4A"/>
    <path d="M40 62l7 8 7-8M66 62l7 8 7-8" stroke="#241238" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M40 84c6 6 34 6 40 0" stroke="#241238" stroke-width="4" fill="none" stroke-linecap="round"/>
  </svg>

  <svg class="seasonal-ghost seasonal-ghost--a" viewBox="0 0 100 100" width="52" height="52">
    <defs>
      <linearGradient id="gg-a" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F3EBFB"/>
        <stop offset="100%" stop-color="#D6C3EF"/>
      </linearGradient>
    </defs>
    <path fill="url(#gg-a)" stroke="#4A2E6B" stroke-width="2" stroke-opacity="0.35" d="M50 8c17 0 30 14 30 34v40l-9-8-8 8-13-8-13 8-8-8-9 8V42C20 22 33 8 50 8Z"/>
    <circle cx="39" cy="40" r="4" fill="#2B1B40" opacity="0.85"/>
    <circle cx="61" cy="40" r="4" fill="#2B1B40" opacity="0.85"/>
  </svg>

  <span class="seasonal-glow seasonal-glow--a"></span>
  <span class="seasonal-glow seasonal-glow--b"></span>
</div>
{% endif %}
