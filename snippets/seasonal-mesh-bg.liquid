<!-- snippets/seasonal-mesh-bg.liquid
     Fixed, full-viewport gradient-mesh background + drifting embers.
     Sits at z-index -1 behind all content - never intercepts clicks,
     never affects layout. Pairs with the .halloween-theme palette in
     theme.css. Motion is dropped under prefers-reduced-motion. -->
<div class="seasonal-mesh" aria-hidden="true">
  <span class="seasonal-mesh__blob seasonal-mesh__blob--orange"></span>
  <span class="seasonal-mesh__blob seasonal-mesh__blob--purple"></span>
  <span class="seasonal-mesh__blob seasonal-mesh__blob--green"></span>
  <div class="seasonal-embers">
    {% for i in (1..14) %}
      <span class="seasonal-ember" style="--i: {{ i }};"></span>
    {% endfor %}
  </div>
</div>
