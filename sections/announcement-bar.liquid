<!-- sections/announcement-bar.liquid -->
{% if section.settings.text != blank %}
  <div class="announcement-bar">{{ section.settings.text }}</div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Free shipping on every order · 30-day easy returns" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
