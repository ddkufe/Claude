<!-- sections/how-it-works.liquid -->
<div class="steps container">
  <div class="steps-header">
    <h2>{{ section.settings.heading }}</h2>
    <p style="color:var(--color-text-muted);">{{ section.settings.subheading }}</p>
  </div>
  <div class="steps-grid">
    {% for block in section.blocks %}
      <div class="step-card reveal" {{ block.shopify_attributes }}>
        <div class="step-number">{{ forloop.index }}</div>
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. No struggle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mount it once and every jar after that opens in seconds." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stick it under a cabinet" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Peel-and-stick or screw mount — done in under 5 minutes, no tools required." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Mount it once", "text": "Peel-and-stick or screw it under any cabinet or shelf. Takes under 5 minutes." } },
        { "type": "step", "settings": { "heading": "Push the jar up", "text": "Press the lid into the grip — the teeth lock on so your hand doesn't have to." } },
        { "type": "step", "settings": { "heading": "Twist with your palm", "text": "Turn the jar, not your wrist. The lid loosens instantly, every time." } }
      ]
    }
  ]
}
{% endschema %}
