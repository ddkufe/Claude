<!-- sections/featured-product.liquid -->
{% assign product = section.settings.product %}
<div class="steps container">
  <div class="section-heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% if product != blank %}
    <div class="product-grid" style="max-width:340px;margin:0 auto;">
      <a href="{{ product.url }}" class="product-card">
        <div class="product-card-media">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: product.featured_image.aspect_ratio }}">
          {% endif %}
        </div>
        <div class="product-card-body">
          <div class="product-card-title">{{ product.title }}</div>
          <div class="product-card-price">{{ product.price | money }}</div>
        </div>
      </a>
    </div>
    <div style="text-align:center;margin-top:28px;">
      <a href="{{ product.url }}" class="btn btn--primary btn--large">{{ 'products.product.view_details' | t }}</a>
    </div>
  {% else %}
    <p style="text-align:center;color:var(--color-text-muted);">Select a product in the theme editor.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our bestseller" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
