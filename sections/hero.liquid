<!-- sections/hero.liquid -->
{%- liquid
  assign hero_image = section.settings.image
  assign hero_product = section.settings.product
  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif
-%}

<div class="hero">
  <div class="container hero-grid">
    <div class="reveal">
      {% if section.settings.eyebrow != blank %}
        <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <p style="font-size:1.2rem;color:var(--color-text-muted);max-width:48ch;">{{ section.settings.subheading }}</p>
      <div class="hero-actions">
        {% if section.settings.button_label != blank %}
          {%- liquid
            assign primary_url = section.settings.button_url
            if primary_url == blank and hero_product != blank
              assign primary_url = hero_product.url
            endif
            if primary_url == blank
              assign primary_url = routes.all_products_collection_url
            endif
          -%}
          <a href="{{ primary_url }}" class="btn btn--primary btn--large">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_url_2 | default: '#how-it-works' }}" class="btn btn--outline btn--large">{{ section.settings.button_label_2 }}</a>
        {% endif %}
      </div>
      <div class="hero-trust">
        <span class="pill">{% render 'icon', name: 'check' %} One-handed use</span>
        <span class="pill">{% render 'icon', name: 'check' %} No twisting or gripping</span>
        <span class="pill">{% render 'icon', name: 'check' %} 30-day guarantee</span>
      </div>
    </div>

    <div class="hero-media-wrap reveal">
      <div class="hero-media">
        {% if hero_image != blank %}
          <img
            src="{{ hero_image | image_url: width: 1000 }}"
            srcset="{{ hero_image | image_url: width: 600 }} 600w, {{ hero_image | image_url: width: 1000 }} 1000w, {{ hero_image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 860px) 92vw, 46vw"
            alt="{{ hero_image.alt | default: section.settings.heading | escape }}"
            width="1000"
            height="{{ 1000 | divided_by: hero_image.aspect_ratio }}"
            loading="eager"
          >
        {% else %}
          <div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>

      {% if section.settings.badge_text != blank %}
        <span class="hero-badge">{{ section.settings.badge_text }}</span>
      {% endif %}

      {% if hero_product != blank and section.settings.show_price %}
        <span class="hero-price-tag">
          <small>From</small>
          <strong>{{ hero_product.price | money }}</strong>
        </span>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Built for weaker grips" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open any jar. One hand. Zero struggle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our under-cabinet jar opener mounts once and grips every lid so you don't have to. Designed for arthritis, weak grip, and anyone tired of fighting stuck jars." },
    { "type": "image_picker", "id": "image", "label": "Image (falls back to the product photo below)" },
    { "type": "product", "id": "product", "label": "Featured product (for image, link, and price)" },
    { "type": "text", "id": "badge_text", "label": "Floating badge text", "default": "Fits 99% of lids" },
    { "type": "checkbox", "id": "show_price", "label": "Show price tag", "default": true },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the jar opener" },
    { "type": "url", "id": "button_url", "label": "Primary button link (defaults to the product above)" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "See how it works" },
    { "type": "url", "id": "button_url_2", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
