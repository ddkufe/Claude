<!-- sections/hero.liquid -->
<div class="hero">
  <div class="container hero-grid">
    <div>
      {% if section.settings.eyebrow != blank %}
        <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <p style="font-size:1.2rem;color:var(--color-text-muted);max-width:48ch;">{{ section.settings.subheading }}</p>
      <div class="hero-actions">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_url }}" class="btn btn--primary btn--large">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_url_2 }}" class="btn btn--outline btn--large">{{ section.settings.button_label_2 }}</a>
        {% endif %}
      </div>
      <div class="hero-trust">
        <span class="pill">{% render 'icon', name: 'check' %} One-handed use</span>
        <span class="pill">{% render 'icon', name: 'check' %} No twisting or gripping</span>
        <span class="pill">{% render 'icon', name: 'check' %} 30-day guarantee</span>
      </div>
    </div>
    <div class="hero-media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="1000" height="{{ 1000 | divided_by: section.settings.image.aspect_ratio }}" loading="eager">
      {% else %}
        <img src="{{ 'under-cabinet-jar-opener' | placeholder_svg_tag }}" alt="">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Built for weaker grips" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open any jar. One hand. Zero struggle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Our under-cabinet jar opener mounts once and grips every lid so you don't have to. Designed for arthritis, weak grip, and anyone tired of fighting stuck jars." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the jar opener" },
    { "type": "url", "id": "button_url", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "See how it works" },
    { "type": "url", "id": "button_url_2", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
