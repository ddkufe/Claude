<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX8">
		<Properties>
			<string name="Name">Combat</string>
		</Properties>
		<Item class="Script" referent="RBX9">
			<Properties>
				<string name="Name">CombatServer</string>
				<ProtectedString name="Source"><![CDATA[-- ServerScriptService/Combat/CombatServer (Script)
-- Receives combat requests, validates timing/range/state, and resolves hits.
-- Clients do their own hit detection for responsiveness; the server re-checks
-- every reported victim (range, facing, cooldowns, stun) before applying it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = ReplicatedStorage:WaitForChild("Combat")
local Config = require(Combat.Config)
local Hitbox = require(Combat.Hitbox)
local State = require(script.Parent.CombatState)
local Resolver = require(script.Parent.HitResolver)

local function getRemote(name)
	local r = Combat:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = Combat
	end
	return r
end

local Request = getRemote("CombatRequest")
local Events = getRemote("CombatEvents")
Resolver.init(Events)

local handlers = {}

function handlers.M1(_player, character, payload)
	local s = State.get(character)
	if not State.canAct(character) or State.isBlocking(character) or State.isDiving(character) then
		return
	end
	local now = State.now()
	if now - s.lastSwing < Config.M1.SwingCooldown * 0.8 then
		return
	end

	local index = (now - s.lastSwing > Config.M1.ComboResetTime) and 1 or (s.combo % Config.M1.ComboLength) + 1
	s.combo = index
	s.lastSwing = now
	s.swingIndex = index
	s.swingHitDone = false

	local kind, pose = "Jab", "Jab" .. ((index - 1) % 3 + 1)
	if index == Config.M1.ComboLength then
		s.combo = 0
		-- The server's copy of the attacker lags a little behind the client, hence the slack.
		local height = Hitbox.groundDistance(character, 80)
		if payload.slam == true and height >= Config.Slam.MinHeight - 4 then
			kind, pose = "Spike", "SlamDive"
			s.slamStart = now
		elseif payload.up == true then
			kind, pose = "Uptilt", "Uptilt"
			s.endLagUntil = now + Config.Uptilt.EndLag
		else
			kind, pose = "Finisher", "Finisher"
			s.endLagUntil = now + Config.M1.EndLag
		end
	end
	s.swingKind = kind

	Resolver.fxAll("Pose", { character = character, name = pose, fromAttacker = true })
	if kind == "Spike" then
		Resolver.fxAll("SlamStart", { character = character })
	end
end

function handlers.M1Hit(player, character, payload)
	local s = State.get(character)
	local now = State.now()
	if s.swingHitDone or not s.swingKind or now - s.lastSwing > 0.6 then
		return
	end
	s.swingHitDone = true
	-- Got hit during your own windup: you lose the trade.
	if State.isStunned(character) or type(payload.hits) ~= "table" then
		return
	end

	local kind = s.swingKind
	local range = kind == "Spike" and Config.Hit.SlamValidationRange or Config.Hit.MaxValidationRange
	local root = character.HumanoidRootPart
	local look = root.CFrame.LookVector
	local results, seen, count = {}, {}, 0

	for _, victim in ipairs(payload.hits) do
		if count >= Config.Hit.MaxTargets then
			break
		end
		if typeof(victim) == "Instance" and victim:IsA("Model") and victim ~= character and not seen[victim] then
			seen[victim] = true
			if State.alive(victim) then
				local offset = victim.HumanoidRootPart.Position - root.Position
				local inFront = offset.Magnitude < 3 or look:Dot(offset.Unit) >= Config.Hit.MinFacingDot
				if offset.Magnitude <= range and (inFront or kind == "Spike") then
					count += 1
					table.insert(results, Resolver.applyHit(character, victim, kind, s.swingIndex))
				end
			end
		end
	end

	if count > 0 then
		Resolver.fxPlayer(player, "HitConfirm", { kind = kind, results = results })
	end
end

function handlers.SlamLand(player, character, payload)
	local s = State.get(character)
	local start = s.slamStart
	s.slamStart = nil
	if not start or State.now() - start > 3 or typeof(payload.position) ~= "Vector3" then
		return
	end
	-- The client lands before the server sees it (ping), so trust its landing
	-- point within a generous radius, then confirm there's real ground there.
	local root = character.HumanoidRootPart
	if (payload.position - root.Position).Magnitude > 45 then
		return
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { character }
	local ground = workspace:Raycast(payload.position + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), rp)
	if not ground then
		return
	end

	s.endLagUntil = State.now() + Config.Slam.EndLag
	local pos, normal, material, color = Resolver.surfaceInfo(ground)
	Resolver.fxAll("Impact", { position = pos, normal = normal, material = material, color = color, intensity = 1.8 })
	Resolver.fxAll("Pose", { character = character, name = "SlamLand", fromAttacker = true })

	local victims = Hitbox.radius(pos, Config.Slam.AoERadius, { character })
	local results = {}
	for _, victim in ipairs(victims) do
		table.insert(results, Resolver.applyHit(character, victim, "SlamAoE", 0))
	end
	if #victims > 0 then
		Resolver.fxPlayer(player, "HitConfirm", { kind = "SlamAoE", results = results })
	end
end

function handlers.Dodge(_player, character)
	local s = State.get(character)
	local now = State.now()
	if now < s.dodgeReady then
		return
	end
	if State.isStunned(character) then
		if not Config.Dodge.CanEscapeStun then
			return
		end
		character:SetAttribute("StunEnd", now)
	end
	s.dodgeReady = now + Config.Dodge.Cooldown
	State.grantIFrames(character, Config.Dodge.IFrames + 0.05)
	if State.isBlocking(character) then
		State.setBlocking(character, false)
	end
	Resolver.fxAll("Dodge", { character = character })
	Resolver.fxAll("Pose", { character = character, name = "Dodge", fromAttacker = true })
end

function handlers.Block(_player, character, payload)
	local s = State.get(character)
	if payload.on == true then
		if State.isBlocking(character) or not State.canAct(character) or State.isDiving(character) or State.now() < s.blockReady then
			return
		end
		State.setBlocking(character, true)
		Resolver.fxAll("Pose", { character = character, name = "Block", fromAttacker = true })
	elseif State.isBlocking(character) then
		State.setBlocking(character, false)
		Resolver.fxAll("PoseRelease", { character = character, name = "Block" })
	end
end

local rate = {}

Request.OnServerEvent:Connect(function(player, action, payload)
	local handler = type(action) == "string" and handlers[action]
	if not handler then
		return
	end
	local character = player.Character
	if not character or not State.alive(character) then
		return
	end

	local now = os.clock()
	local r = rate[player]
	if not r or now - r.window > 1 then
		r = { window = now, count = 0 }
		rate[player] = r
	end
	r.count += 1
	if r.count > 25 then
		return
	end

	handler(player, character, type(payload) == "table" and payload or {})
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		character:SetAttribute("StunEnd", 0)
		character:SetAttribute("IFrameEnd", 0)
		character:SetAttribute("Blocking", false)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	rate[player] = nil
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX10">
			<Properties>
				<string name="Name">CombatState</string>
				<ProtectedString name="Source"><![CDATA[-- ServerScriptService/Combat/CombatState (ModuleScript)
-- Per-character combat state. Timers that clients need to read are mirrored
-- as attributes on the character, in workspace:GetServerTimeNow() units.

local Players = game:GetService("Players")

local Config = require(game:GetService("ReplicatedStorage").Combat.Config)

local CombatState = {}

local data = setmetatable({}, { __mode = "k" })

function CombatState.now()
	return workspace:GetServerTimeNow()
end

function CombatState.get(character)
	local s = data[character]
	if not s then
		s = {
			combo = 0,
			lastSwing = -math.huge,
			swingKind = nil,
			swingHitDone = true,
			endLagUntil = 0,
			dodgeReady = 0,
			blockStart = 0,
			blockReady = 0,
			slamStart = nil,
		}
		data[character] = s
	end
	return s
end

local function humanoidOf(character)
	return character and character:FindFirstChildOfClass("Humanoid")
end

function CombatState.alive(character)
	local h = humanoidOf(character)
	return h ~= nil and h.Health > 0 and character:FindFirstChild("HumanoidRootPart") ~= nil
end

function CombatState.isStunned(character)
	return (character:GetAttribute("StunEnd") or 0) > CombatState.now()
end

function CombatState.hasIFrames(character)
	return (character:GetAttribute("IFrameEnd") or 0) > CombatState.now()
end

function CombatState.isBlocking(character)
	return character:GetAttribute("Blocking") == true
end

-- Times out so a client that never reports landing can't lock itself up.
function CombatState.isDiving(character)
	local start = CombatState.get(character).slamStart
	return start ~= nil and CombatState.now() - start < 3
end

function CombatState.canAct(character)
	if not CombatState.alive(character) or CombatState.isStunned(character) then
		return false
	end
	return CombatState.now() >= CombatState.get(character).endLagUntil
end

function CombatState.stun(character, duration)
	local now = CombatState.now()
	local finish = math.max(character:GetAttribute("StunEnd") or 0, now + duration)
	character:SetAttribute("StunEnd", finish)
	character:SetAttribute("Blocking", false)

	local s = CombatState.get(character)
	s.combo = 0
	s.slamStart = nil

	-- Players' speed is driven by their own client from the StunEnd attribute.
	-- NPCs are server-owned, so slow them here.
	if not Players:GetPlayerFromCharacter(character) then
		local humanoid = humanoidOf(character)
		if humanoid then
			if humanoid:GetAttribute("BaseWalkSpeed") == nil then
				humanoid:SetAttribute("BaseWalkSpeed", humanoid.WalkSpeed)
			end
			humanoid.WalkSpeed = Config.Movement.StunnedSpeed
			task.delay(finish - now + 0.02, function()
				if humanoid.Parent and not CombatState.isStunned(character) then
					humanoid.WalkSpeed = humanoid:GetAttribute("BaseWalkSpeed")
				end
			end)
		end
	end
end

function CombatState.grantIFrames(character, duration)
	character:SetAttribute("IFrameEnd", CombatState.now() + duration)
end

function CombatState.setBlocking(character, on)
	character:SetAttribute("Blocking", on)
	local s = CombatState.get(character)
	if on then
		s.blockStart = CombatState.now()
	else
		s.blockReady = CombatState.now() + Config.Block.ReleaseCooldown
	end
end

return CombatState
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX11">
			<Properties>
				<string name="Name">HitResolver</string>
				<ProtectedString name="Source"><![CDATA[-- ServerScriptService/Combat/HitResolver (ModuleScript)
-- Server-authoritative outcome of a hit: i-frames, block / parry / guard break,
-- damage, hitstun, knockback, and wall/ground impact detection.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Combat = ReplicatedStorage.Combat
local Config = require(Combat.Config)
local Hitbox = require(Combat.Hitbox)
local Knockback = require(Combat.Knockback)
local State = require(script.Parent.CombatState)

local Resolver = {}

local events
local HEAVY = { Finisher = true, Uptilt = true, Spike = true, SlamAoE = true }

function Resolver.init(remote)
	events = remote
end

function Resolver.fxAll(name, payload)
	events:FireAllClients(name, payload)
end

function Resolver.fxPlayer(player, name, payload)
	events:FireClient(player, name, payload)
end

function Resolver.knockback(character, velocity, duration)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		events:FireClient(player, "Knockback", { velocity = velocity, duration = duration })
	else
		Knockback.apply(character, velocity, duration)
	end
end

function Resolver.stopKnockback(character)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		events:FireClient(player, "StopKnockback")
	else
		Knockback.stop(character)
	end
end

function Resolver.surfaceInfo(result)
	local color = Color3.fromRGB(110, 105, 100)
	local inst = result.Instance
	if inst:IsA("Terrain") then
		pcall(function()
			color = workspace.Terrain:GetMaterialColor(result.Material)
		end)
	elseif inst:IsA("BasePart") then
		color = inst.Color
	end
	return result.Position, result.Normal, result.Material, color
end

local function isCharacterPart(inst)
	local model = inst:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

function Resolver.canDamage(attacker, victim)
	if Config.Hit.FriendlyFire ~= false then
		return true
	end
	local a = Players:GetPlayerFromCharacter(attacker)
	local v = Players:GetPlayerFromCharacter(victim)
	return not (a and v and a.Team ~= nil and a.Team == v.Team)
end

-- mode "Wall": horizontal launches splat into walls.
-- mode "Ground": spikes crater into the floor and bounce.
function Resolver.watchImpact(victim, attacker, mode)
	local hrp = victim:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { victim, attacker }

	local started = State.now()
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not hrp.Parent or State.now() - started > Config.Impact.WatchTime then
			conn:Disconnect()
			return
		end
		local velocity = hrp.AssemblyLinearVelocity
		local speed = velocity.Magnitude
		if speed < Config.Impact.MinSpeed then
			return
		end
		local result = workspace:Raycast(hrp.Position, velocity.Unit * (speed * dt * 1.5 + 2.6), rp)
		if not result or isCharacterPart(result.Instance) then
			return
		end
		if result.Instance:IsA("BasePart") and not result.Instance.CanCollide then
			return
		end
		local isGround = result.Normal.Y > 0.6
		if mode == "Wall" and isGround then
			return
		end

		conn:Disconnect()
		local pos, normal, material, color = Resolver.surfaceInfo(result)
		Resolver.fxAll("Impact", {
			position = pos,
			normal = normal,
			material = material,
			color = color,
			intensity = math.clamp(speed / 60, 0.6, 2),
		})

		if isGround then
			Resolver.knockback(victim, Vector3.new(0, Config.Impact.GroundBounce, 0), 0.08)
		else
			Resolver.stopKnockback(victim)
			local humanoid = victim:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:TakeDamage(Config.Impact.WallSplatDamage)
			end
			State.stun(victim, Config.Impact.WallSplatStun)
			Resolver.fxAll("Hit", { victim = victim, position = pos, kind = "WallSplat", direction = normal })
		end
	end)
end

local function damageFor(kind, index)
	if kind == "Jab" then
		return Config.M1.Damage[index] or Config.M1.Damage[1]
	elseif kind == "Finisher" then
		return Config.M1.Damage[Config.M1.ComboLength]
	elseif kind == "Uptilt" then
		return Config.Uptilt.Damage
	elseif kind == "Spike" then
		return Config.Slam.SpikeDamage
	elseif kind == "SlamAoE" then
		return Config.Slam.AoEDamage
	end
	return 0
end

local function flatLook(root)
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	return look.Magnitude > 0.01 and look.Unit or Vector3.zAxis
end

local function tryBlock(attacker, victim, kind, index, hitPos, humanoid)
	local aRoot, vRoot = attacker.HumanoidRootPart, victim.HumanoidRootPart
	local toAttacker = (aRoot.Position - vRoot.Position) * Vector3.new(1, 0, 1)
	local frontal = toAttacker.Magnitude < 0.1
		or flatLook(vRoot):Dot(toAttacker.Unit) >= math.cos(math.rad(Config.Block.MaxAngle))
	if not frontal or kind == "SlamAoE" then
		return nil
	end

	if State.now() - State.get(victim).blockStart <= Config.Block.PerfectWindow then
		State.stun(attacker, Config.Block.ParryStun)
		Resolver.fxAll("Parry", { position = hitPos })
		Resolver.fxAll("Pose", { character = attacker, name = "GuardBroken" })
		return "parried"
	end

	if HEAVY[kind] then
		State.setBlocking(victim, false)
		humanoid:TakeDamage(Config.Block.GuardBreakDamage)
		State.stun(victim, Config.Block.GuardBreakStun)
		Resolver.fxAll("GuardBreak", { position = hitPos })
		Resolver.fxAll("Pose", { character = victim, name = "GuardBroken" })
		return "guardbreak"
	end

	humanoid:TakeDamage(damageFor(kind, index) * Config.Block.DamageMultiplier)
	Resolver.knockback(victim, flatLook(aRoot) * Config.Block.Pushback, 0.1)
	Resolver.fxAll("Block", { position = hitPos })
	return "blocked"
end

function Resolver.applyHit(attacker, victim, kind, index)
	if not State.alive(victim) or not State.alive(attacker) or not Resolver.canDamage(attacker, victim) then
		return "none"
	end
	local humanoid = victim:FindFirstChildOfClass("Humanoid")
	local aRoot, vRoot = attacker.HumanoidRootPart, victim.HumanoidRootPart
	local flat = flatLook(aRoot)
	local offset = aRoot.Position - vRoot.Position
	local hitPos = vRoot.Position + (offset.Magnitude > 0.1 and offset.Unit or flat) * 1.1

	if State.hasIFrames(victim) then
		Resolver.fxAll("Dodged", { victim = victim })
		return "dodged"
	end

	if State.isBlocking(victim) then
		local blocked = tryBlock(attacker, victim, kind, index, hitPos, humanoid)
		if blocked then
			return blocked
		end
	end

	humanoid:TakeDamage(damageFor(kind, index))

	local stun, velocity, duration, watch
	if kind == "Jab" then
		stun = Config.M1.HitStun
		if Hitbox.groundDistance(attacker, 30) > 3 then
			velocity = flat * 4 + Vector3.new(0, Config.Air.JuggleLift, 0)
			duration = 0.12
		else
			velocity = flat * Config.M1.JabPush
			duration = 0.1
		end
	elseif kind == "Finisher" then
		stun = Config.M1.FinisherStun
		velocity = flat * Config.M1.FinisherKnockback + Vector3.new(0, Config.M1.FinisherLift, 0)
		duration = 0.22
		watch = "Wall"
	elseif kind == "Uptilt" then
		stun = Config.Uptilt.Stun
		velocity = flat * 4 + Vector3.new(0, Config.Uptilt.Launch, 0)
		duration = Config.Uptilt.LaunchTime
	elseif kind == "Spike" then
		stun = Config.Slam.SpikeStun
		velocity = flat * 8 + Vector3.new(0, -Config.Slam.SpikeVelocity, 0)
		duration = 0.5
		watch = "Ground"
	else -- SlamAoE
		local out = (vRoot.Position - aRoot.Position) * Vector3.new(1, 0, 1)
		out = out.Magnitude > 0.1 and out.Unit or flat
		stun = Config.Slam.AoEStun
		velocity = out * Config.Slam.AoEKnockback + Vector3.new(0, Config.Slam.AoELift, 0)
		duration = 0.18
		watch = "Wall"
	end

	State.stun(victim, stun)
	Resolver.knockback(victim, velocity, duration)
	if watch then
		Resolver.watchImpact(victim, attacker, watch)
	end

	Resolver.fxAll("Hit", { victim = victim, position = hitPos, kind = kind, direction = velocity.Unit })
	Resolver.fxAll("Pose", { character = victim, name = "Hurt" })
	local victimPlayer = Players:GetPlayerFromCharacter(victim)
	if victimPlayer then
		Resolver.fxPlayer(victimPlayer, "Hurt", { kind = kind })
	end
	return "hit"
end

return Resolver
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
