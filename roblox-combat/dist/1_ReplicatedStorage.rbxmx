<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties>
			<string name="Name">Combat</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">ClientEvents</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/ClientEvents (ModuleScript, client-side use)
-- Turns server broadcasts into poses, VFX, camera shake and local knockback.

local Players = game:GetService("Players")

local Combat = script.Parent
local Crater = require(Combat.Crater)
local Knockback = require(Combat.Knockback)
local Poses = require(Combat.Poses)
local VFX = require(Combat.VFX)

local ClientEvents = {}

local player = Players.LocalPlayer

local function myRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function shakeNear(position, radius, strength, duration)
	local root = myRoot()
	if not root then
		return
	end
	local distance = (root.Position - position).Magnitude
	if distance < radius then
		VFX.shake(strength * (1 - distance / radius), duration)
	end
end

function ClientEvents.connect(callbacks)
	local events = Combat:WaitForChild("CombatEvents")

	events.OnClientEvent:Connect(function(name, payload)
		payload = payload or {}
		local mine = payload.character ~= nil and payload.character == player.Character

		if name == "Pose" then
			-- Our own attacks/dodges/blocks were already played locally.
			if not (mine and payload.fromAttacker) then
				Poses.play(payload.character, payload.name)
			end
		elseif name == "PoseRelease" then
			if not mine then
				Poses.release(payload.character, payload.name)
			end
		elseif name == "Hit" then
			VFX.hit(payload.victim, payload.position, payload.kind, payload.direction)
		elseif name == "Impact" then
			Crater.spawn(payload.position, payload.normal, payload.material, payload.color, payload.intensity)
			shakeNear(payload.position, 70, 3.5 * (payload.intensity or 1), 0.4)
		elseif name == "Block" then
			VFX.block(payload.position)
		elseif name == "Parry" then
			VFX.parry(payload.position)
			shakeNear(payload.position, 30, 2, 0.2)
		elseif name == "GuardBreak" then
			VFX.guardBreak(payload.position)
			shakeNear(payload.position, 30, 2, 0.25)
		elseif name == "Dodge" then
			if not mine then
				VFX.dodge(payload.character)
			end
		elseif name == "Dodged" then
			VFX.afterimage(payload.victim, Color3.fromRGB(170, 220, 255))
		elseif name == "SlamStart" then
			if not mine then
				VFX.trail(payload.character, VFX.KindColors.Spike, 1.5)
			end
		elseif name == "Knockback" then
			if player.Character then
				Knockback.apply(player.Character, payload.velocity, payload.duration)
			end
		elseif name == "StopKnockback" then
			Knockback.stop(player.Character)
		elseif name == "Hurt" then
			VFX.shake(payload.kind == "Jab" and 1 or 2.5, 0.25)
			if callbacks.onHurt then
				callbacks.onHurt(payload)
			end
		elseif name == "HitConfirm" then
			if callbacks.onHitConfirm then
				callbacks.onHitConfirm(payload)
			end
		end
	end)
end

return ClientEvents
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Config (ModuleScript)
-- Every tunable number for the combat system lives here.

local Config = {}

Config.Debug = {
	ShowHitboxes = false,
}

Config.M1 = {
	ComboLength = 4,
	ComboResetTime = 1.1,
	SwingCooldown = 0.32,
	EndLag = 0.85,
	Windup = 0.11,
	Damage = { 3.5, 3.5, 4, 7 },
	HitboxSize = Vector3.new(5.5, 6, 5.5),
	HitboxOffset = 3.2,
	Lunge = 16,
	LungeTime = 0.09,
	HitStun = 0.55,
	FinisherStun = 0.9,
	FinisherKnockback = 70,
	FinisherLift = 14,
	JabPush = 7,
	AutoFaceRange = 11,
	AutoFaceAngle = 75,
}

Config.Air = {
	JuggleLift = 20,
	AttackerHang = 9,
}

Config.Uptilt = {
	Damage = 6,
	Launch = 70,
	LaunchTime = 0.16,
	Stun = 1.15,
	AttackerHop = 72,
	EndLag = 0.2,
}

Config.Slam = {
	MinHeight = 7,
	DiveVelocity = 140,
	SpikeDamage = 6,
	SpikeVelocity = 120,
	SpikeStun = 1.2,
	AoEDamage = 6,
	AoERadius = 10,
	AoEStun = 0.9,
	AoEKnockback = 45,
	AoELift = 32,
	EndLag = 0.6,
	HitboxSize = Vector3.new(7, 9, 7),
}

Config.Dodge = {
	Cooldown = 1.6,
	IFrames = 0.3,
	Speed = 90,
	Duration = 0.2,
	CanEscapeStun = false,
	DefaultDirection = "Forward",
}

Config.Block = {
	DamageMultiplier = 0.15,
	PerfectWindow = 0.16,
	ParryStun = 1.1,
	GuardBreakStun = 1.4,
	GuardBreakDamage = 4,
	MaxAngle = 75,
	Pushback = 10,
	ReleaseCooldown = 0.25,
}

Config.Impact = {
	MinSpeed = 35,
	WallSplatDamage = 3,
	WallSplatStun = 0.7,
	GroundBounce = 24,
	WatchTime = 0.7,
}

Config.Movement = {
	WalkSpeed = 16,
	StanceWalkSpeed = 14, -- while in the combat stance
	SprintSpeed = 28,
	AttackingSpeed = 9,
	BlockingSpeed = 6,
	StunnedSpeed = 3,
	JumpPower = 50,
}

-- Ninja combat stance (see animations/STANCE_SPEC.md). Plays procedurally from
-- Combat/StanceData until all four Config.Animations.Stance* ids are filled in.
Config.Stance = {
	Enabled = true,
	AutoEnter = true, -- first attack / block / dodge drops you into the stance
	ExitDelay = 3.0, -- seconds without a combat action before relaxing
	ToggleKey = Enum.KeyCode.C, -- hold the stance until toggled off (gamepad: ButtonY)
	EnterTime = 0.27, -- length of the draw-in (matches STANCE_ENTER)
	ExitTime = 0.25, -- length of the relax (matches STANCE_EXIT)
	BlendSpeed = 12, -- how fast idle <-> moving blends
	MoveSpeedThreshold = 2.5, -- studs/s of horizontal speed that counts as moving
}

Config.Hit = {
	MaxTargets = 4,
	MaxValidationRange = 14,
	SlamValidationRange = 18,
	MinFacingDot = -0.35,
	-- false = players on the same Team (village) can't damage each other
	FriendlyFire = true,
}

-- Optional: paste real uploaded R6 animation ids here (e.g. "rbxassetid://123").
-- Any move left as "" falls back to the built-in procedural pose.
Config.Animations = {
	Jab1 = "",
	Jab2 = "",
	Jab3 = "",
	Finisher = "",
	Uptilt = "",
	SlamDive = "",
	SlamLand = "",
	Hurt = "",
	Block = "",
	Dodge = "",
	GuardBroken = "",
	StanceEnter = "",
	StanceIdle = "",
	StanceExit = "",
	StanceMove = "",
}

return Config
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Crater</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Crater (ModuleScript, client-side use)
-- Ground/wall impact: a ring of rubble that matches the surface's material and
-- color, flying debris chunks, a dust cloud and a shockwave disc. Works on any
-- surface orientation, so the same call makes floor craters and wall splats.

local Debris = game:GetService("Debris")

local VFX = require(script.Parent.VFX)

local Crater = {}

local rng = Random.new()

local function applyLook(p, material, color)
	pcall(function()
		p.Material = material
	end)
	p.Color = color
end

local function surfaceBasis(position, normal)
	local up = normal.Unit
	local ref = math.abs(up.Y) > 0.95 and Vector3.zAxis or Vector3.yAxis
	local right = ref:Cross(up).Unit
	return CFrame.fromMatrix(position, right, up)
end

local function rubbleRing(base, material, color, intensity)
	local count = math.floor(8 + 6 * intensity)
	local radius = 2.5 + 2.5 * intensity
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local scale = 0.8 + 0.35 * intensity
		local size = Vector3.new(rng:NextNumber(1.2, 2.3), rng:NextNumber(0.8, 1.7), rng:NextNumber(1.2, 2.3)) * scale
		local offset = Vector3.new(math.cos(angle) * radius, size.Y * 0.15, math.sin(angle) * radius)
		local final = base
			* CFrame.new(offset)
			* CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.6, 0.6))
		local rock = Instance.new("Part")
		rock.Anchored = true
		rock.CanCollide = false
		rock.CanQuery = false
		rock.CanTouch = false
		rock.Size = size
		rock.CFrame = final * CFrame.new(0, -size.Y * 1.5, 0)
		applyLook(rock, material, color)
		rock.Parent = VFX.folder()

		VFX.tween(rock, 0.14, { CFrame = final }, Enum.EasingStyle.Back)
		local linger = 2.5 + rng:NextNumber(0, 1)
		task.delay(linger, function()
			VFX.tween(rock, 0.6, { CFrame = final * CFrame.new(0, -size.Y * 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
		Debris:AddItem(rock, linger + 0.7)
	end
end

local function flyingDebris(position, base, material, color, intensity)
	local up = base.UpVector
	for _ = 1, math.floor(5 + 5 * intensity) do
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.one * rng:NextNumber(0.5, 1.1)
		chunk.CFrame = CFrame.new(position + up * 1.2) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		chunk.CanQuery = false
		chunk.CanTouch = false
		applyLook(chunk, material, color)
		chunk.Parent = VFX.folder()

		local tangent = (base.RightVector * rng:NextNumber(-1, 1) + base.LookVector * rng:NextNumber(-1, 1))
		tangent = tangent.Magnitude > 0 and tangent.Unit or base.RightVector
		chunk.AssemblyLinearVelocity = up * rng:NextNumber(30, 55) * intensity + tangent * rng:NextNumber(12, 30)
		chunk.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-15, 15), rng:NextNumber(-15, 15), rng:NextNumber(-15, 15))

		task.delay(1.6, function()
			VFX.tween(chunk, 0.5, { Transparency = 1 })
		end)
		Debris:AddItem(chunk, 2.2)
	end
end

function Crater.spawn(position, normal, material, color, intensity)
	intensity = math.clamp(intensity or 1, 0.4, 2.5)
	normal = (normal and normal.Magnitude > 0) and normal or Vector3.yAxis
	if material == nil or material == Enum.Material.Air then
		material = Enum.Material.Slate
	end
	color = color or Color3.fromRGB(110, 105, 100)

	local base = surfaceBasis(position, normal)
	rubbleRing(base, material, color, intensity)
	flyingDebris(position, base, material, color, intensity)

	VFX.burst(position + normal * 1, {
		texture = VFX.Textures.Smoke,
		color = Color3.fromRGB(175, 165, 150),
		count = math.floor(12 + 8 * intensity),
		speed = 16 * intensity,
		size = 3 * intensity,
		endSize = 6 * intensity,
		life = 0.9,
		light = 0,
		drag = 5,
		startTransparency = 0.3,
	})
	VFX.ring(position + normal * 0.2, normal, Color3.fromRGB(255, 245, 230), 2, 16 * intensity, 0.35)
	VFX.flashSphere(position, Color3.fromRGB(255, 240, 220), 6 * intensity, 0.18)
end

return Crater
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">Hitbox</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Hitbox (ModuleScript)
-- Spatial-query hitboxes that return living characters (players or NPCs).

local Config = require(script.Parent.Config)

local Hitbox = {}

local function characterFromPart(part)
	local parent = part.Parent
	if not parent then
		return nil
	end
	if parent:IsA("Accessory") then
		parent = parent.Parent
	end
	local humanoid = parent and parent:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return parent
	end
	return nil
end

local function collect(parts, origin)
	local seen, list = {}, {}
	for _, part in ipairs(parts) do
		local character = characterFromPart(part)
		if character and not seen[character] and character:FindFirstChild("HumanoidRootPart") then
			seen[character] = true
			table.insert(list, character)
		end
	end
	table.sort(list, function(a, b)
		return (a.HumanoidRootPart.Position - origin).Magnitude < (b.HumanoidRootPart.Position - origin).Magnitude
	end)
	local max = Config.Hit.MaxTargets
	while #list > max do
		table.remove(list)
	end
	return list
end

local function params(ignore)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = ignore
	return op
end

function Hitbox.box(cframe, size, ignore)
	local parts = workspace:GetPartBoundsInBox(cframe, size, params(ignore))
	return collect(parts, cframe.Position)
end

function Hitbox.radius(position, radius, ignore)
	local parts = workspace:GetPartBoundsInRadius(position, radius, params(ignore))
	return collect(parts, position)
end

function Hitbox.debugDraw(cframe, size, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 0.7
	p.Color = color or Color3.fromRGB(255, 60, 60)
	p.Material = Enum.Material.ForceField
	p.Size = size
	p.CFrame = cframe
	p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 0.25)
end

function Hitbox.groundDistance(character, maxDistance)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return math.huge
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(hrp.Position, Vector3.new(0, -(maxDistance or 200), 0), rp)
	if not result then
		return math.huge, nil
	end
	-- HRP center sits 3 studs above the feet on an R6 rig
	return (hrp.Position - result.Position).Magnitude - 3, result
end

return Hitbox
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">Knockback</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Knockback (ModuleScript)
-- Shared by server (for NPCs it owns) and client (for its own character),
-- because a player's character physics are owned by that player's client.

local Knockback = {}

local NAME = "CombatKnockback"

local function rootOf(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

function Knockback.stop(character)
	local hrp = rootOf(character)
	if not hrp then
		return
	end
	local existing = hrp:FindFirstChild(NAME)
	if existing then
		existing:Destroy()
	end
end

function Knockback.apply(character, velocity, duration)
	local hrp = rootOf(character)
	if not hrp then
		return
	end
	Knockback.stop(character)

	local attachment = hrp:FindFirstChild("RootAttachment") or hrp:FindFirstChildWhichIsA("Attachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "RootAttachment"
		attachment.Parent = hrp
	end

	local lv = Instance.new("LinearVelocity")
	lv.Name = NAME
	lv.Attachment0 = attachment
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = math.huge
	lv.VectorVelocity = velocity
	lv.Parent = hrp

	hrp.AssemblyLinearVelocity = velocity

	task.delay(duration, function()
		if lv.Parent then
			lv:Destroy()
		end
	end)
	return lv
end

return Knockback
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">Poses</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Poses (ModuleScript)
-- Procedural R6 attack/hurt poses, layered on top of the default Animate
-- script by tweening Motor6D.C0. If Config.Animations has a real id for a
-- move, that AnimationTrack is played instead.
-- Rotations are {x, y, z} radians in Torso space at the joint pivot:
--   +x swings a limb forward, +z swings a right limb outward (left limbs: -z),
--   Root +x leans the torso back, Root +y twists the torso left.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent.Config)

local Poses = {}

local MOTORS = {
	RS = { "Torso", "Right Shoulder" },
	LS = { "Torso", "Left Shoulder" },
	RH = { "Torso", "Right Hip" },
	LH = { "Torso", "Left Hip" },
	Neck = { "Torso", "Neck" },
	Root = { "HumanoidRootPart", "RootJoint" },
}

local H = math.pi / 2

Poses.Library = {
	Jab1 = { hold = 0.12, pose = { RS = { H, 0, 0 }, LS = { 0.8, 0, 0.3 }, Root = { -0.1, 0.45, 0 } } },
	Jab2 = { hold = 0.12, pose = { LS = { H, 0, 0 }, RS = { 0.8, 0, -0.3 }, Root = { -0.1, -0.45, 0 } } },
	Jab3 = { hold = 0.14, pose = { RS = { 1.3, 0, 0.9 }, LS = { 0.6, 0, 0.3 }, Root = { -0.15, 0.75, 0 } } },
	Finisher = {
		hold = 0.24,
		pose = { RH = { 1.75, 0, 0 }, LH = { -0.25, 0, 0 }, RS = { 0.4, 0, 0.8 }, LS = { 0.4, 0, -0.8 }, Root = { 0.3, 0.25, 0 } },
	},
	Uptilt = {
		hold = 0.28,
		pose = {
			RS = { 3.0, 0, 0.15 },
			LS = { 0.5, 0, -0.5 },
			RH = { -0.3, 0, 0 },
			LH = { 0.55, 0, 0 },
			Root = { 0.35, 0.3, 0 },
			Neck = { 0.35, 0, 0 },
		},
	},
	SlamDive = {
		hold = 1.6,
		pose = { RS = { 3.0, 0, 0 }, LS = { 3.0, 0, 0 }, RH = { 0.9, 0, 0 }, LH = { 0.9, 0, 0 }, Root = { -0.7, 0, 0 } },
	},
	SlamLand = {
		hold = 0.3,
		pose = { RS = { 1.0, 0, 0.3 }, LS = { 1.0, 0, -0.3 }, RH = { 0.9, 0, 0 }, LH = { -0.6, 0, 0 }, Root = { -0.5, 0, 0 } },
	},
	Hurt = {
		hold = 0.25,
		pose = { RS = { 0.4, 0, 0.6 }, LS = { 0.4, 0, -0.6 }, Root = { 0.35, 0, 0.1 }, Neck = { 0.4, 0, 0 } },
	},
	GuardBroken = {
		hold = 0.8,
		pose = { RS = { 0.6, 0, 1.4 }, LS = { 0.6, 0, -1.4 }, Root = { 0.45, 0, 0 }, Neck = { 0.5, 0, 0 } },
	},
	Block = {
		hold = math.huge,
		pose = { RS = { 1.6, 0, -0.7 }, LS = { 1.6, 0, 0.7 }, Root = { -0.12, 0, 0 }, Neck = { -0.1, 0, 0 } },
	},
	Dodge = {
		hold = 0.18,
		pose = { RS = { -0.5, 0, 0.3 }, LS = { -0.5, 0, -0.3 }, RH = { 0.6, 0, 0 }, LH = { -0.4, 0, 0 }, Root = { -0.45, 0, 0 } },
	},
}

local defaults = setmetatable({}, { __mode = "k" })
local tokens = setmetatable({}, { __mode = "k" })
local tracks = setmetatable({}, { __mode = "k" })
-- character -> { [motor key] = rotation CFrame }: the pose joints return to instead of the
-- default rest pose (used by the combat stance). busyUntil covers a release tween in flight.
local bases = setmetatable({}, { __mode = "k" })
local busyUntil = setmetatable({}, { __mode = "k" })

local function getMotor(character, key)
	local spec = MOTORS[key]
	local part = character:FindFirstChild(spec[1])
	return part and part:FindFirstChild(spec[2])
end

local function baseC0(motor)
	local base = defaults[motor]
	if not base then
		base = motor.C0
		defaults[motor] = base
	end
	return base
end

local function rotated(base, r)
	return CFrame.new(base.Position) * CFrame.Angles(r[1], r[2], r[3]) * base.Rotation
end

local function restCFrame(character, key, motor)
	local base = baseC0(motor)
	local rot = bases[character] and bases[character][key]
	if rot then
		return CFrame.new(base.Position) * rot * base.Rotation
	end
	return base
end

local function tweenC0(motor, goal, duration)
	TweenService:Create(motor, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = goal })
		:Play()
end

function Poses.usesTrack(name)
	local id = Config.Animations[name]
	return id ~= nil and id ~= ""
end

local function playTrack(character, name)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local cache = tracks[character]
	if not cache then
		cache = {}
		tracks[character] = cache
	end
	local track = cache[name]
	if not track then
		local animation = Instance.new("Animation")
		animation.AnimationId = Config.Animations[name]
		track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		cache[name] = track
	end
	track:Play(0.05)
end

function Poses.release(character, name)
	if not character then
		return
	end
	if name and Poses.usesTrack(name) then
		local cache = tracks[character]
		if cache and cache[name] then
			cache[name]:Stop(0.1)
		end
		return
	end
	tokens[character] = nil
	busyUntil[character] = os.clock() + 0.2
	for key in pairs(MOTORS) do
		local motor = getMotor(character, key)
		if motor and defaults[motor] then
			tweenC0(motor, restCFrame(character, key, motor), 0.18)
		end
	end
end

function Poses.play(character, name, hold)
	local entry = Poses.Library[name]
	if not entry or not character then
		return
	end
	hold = hold or entry.hold

	if Poses.usesTrack(name) then
		-- A player's own client plays (and replicates) their tracks.
		local owner = Players:GetPlayerFromCharacter(character)
		if owner and owner ~= Players.LocalPlayer then
			return
		end
		playTrack(character, name)
		return
	end

	local token = {}
	tokens[character] = token
	for key in pairs(MOTORS) do
		local motor = getMotor(character, key)
		if motor then
			local base = baseC0(motor)
			local r = entry.pose[key]
			tweenC0(motor, r and rotated(base, r) or restCFrame(character, key, motor), 0.07)
		end
	end

	if hold ~= math.huge then
		task.delay(0.07 + hold, function()
			if tokens[character] == token then
				Poses.release(character)
			end
		end)
	end
end

-- Stance hooks -------------------------------------------------------------

-- rotations: { Root = CFrame, Neck = ..., RS = ..., LS = ..., RH = ..., LH = ... } (rotation only,
-- same torso-space convention as Library poses). nil clears the base (back to the default rest pose).
function Poses.setBase(character, rotations)
	bases[character] = rotations
end

-- True while an attack/hurt/block pose is held or its release tween is still running.
function Poses.isBusy(character)
	return tokens[character] ~= nil or (busyUntil[character] or 0) > os.clock()
end

-- Writes rotation-only CFrames straight onto the Motor6D C0s (no tween).
function Poses.applyRotations(character, rotations)
	for key, rot in pairs(rotations) do
		local motor = getMotor(character, key)
		if motor then
			local base = baseC0(motor)
			motor.C0 = CFrame.new(base.Position) * rot * base.Rotation
		end
	end
end

return Poses
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7">
			<Properties>
				<string name="Name">Stance</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Stance (ModuleScript, client-side use)
-- The ninja combat stance: draw in -> breathing idle -> relax, with an upper-body
-- guard while moving. Local combat actions enter it; everyone else sees it through
-- the character's "InStance" attribute (set by the server).
--
-- Two ways to play it:
--   * Config.Animations.StanceEnter/Idle/Exit/Move all set -> real AnimationTracks
--     (only the owning client plays them; Roblox replicates them).
--   * otherwise -> procedural: the same keyframes (StanceData) drive Motor6D C0s on
--     every client, through Poses so attacks recover back into the stance.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Combat = script.Parent
local Config = require(Combat.Config)
local Data = require(Combat.StanceData)
local Poses = require(Combat.Poses)

local Stance = {}

local localPlayer = Players.LocalPlayer
local request -- RemoteEvent, set in Stance.init

local MOTOR_KEY = { Root = "Root", Neck = "Neck", RightShoulder = "RS", LeftShoulder = "LS", RightHip = "RH", LeftHip = "LH" }
local UPPER = { "Root", "Neck", "RightShoulder", "LeftShoulder" }
local HIPS = { "RightHip", "LeftHip" }
local IDENTITY = CFrame.new()

-- sampling (pure) -------------------------------------------------------------

local function ease(style, t)
	if style == "CubicOut" then
		return 1 - (1 - t) ^ 3
	elseif style == "CubicIn" then
		return t ^ 3
	elseif style == "CubicInOut" then
		if t < 0.5 then
			return 4 * t ^ 3
		end
		return 1 - ((-2 * t + 2) ^ 3) / 2
	end
	return t -- Linear
end

-- Which two keys time t falls between, and the eased blend between them.
function Stance.locate(anim, t)
	local keys = anim.keys
	if t <= keys[1].t then
		return 1, 1, 0
	end
	for i = 2, #keys do
		if t <= keys[i].t then
			local a, b = keys[i - 1], keys[i]
			return i - 1, i, ease(b.ease, (t - a.t) / (b.t - a.t))
		end
	end
	return #keys, #keys, 0
end

for _, anim in pairs(Data) do
	for _, key in ipairs(anim.keys) do
		key.cf = {}
		for joint, e in pairs(key.pose) do
			key.cf[joint] = CFrame.Angles(math.rad(e[1]), math.rad(e[2]), math.rad(e[3]))
		end
	end
end

local function sample(anim, t)
	local i, j, alpha = Stance.locate(anim, t)
	local from, to = anim.keys[i].cf, anim.keys[j].cf
	local out = {}
	for joint, cf in pairs(from) do
		out[joint] = (i == j) and cf or cf:Lerp(to[joint], alpha)
	end
	return out
end

local function toMotorKeys(rot)
	local out = {}
	for joint, cf in pairs(rot) do
		out[MOTOR_KEY[joint]] = cf
	end
	return out
end

-- state -------------------------------------------------------------------------

-- phase: "off" | "enter" | "hold" | "exit"
local states = setmetatable({}, { __mode = "k" })
local tracks = setmetatable({}, { __mode = "k" })

local function stateOf(character)
	local s = states[character]
	if not s then
		s = { phase = "off", t = 0, mt = 0, blend = 0, locked = false, lastAction = 0, endsAt = 0, trackMoving = false }
		states[character] = s
	end
	return s
end

local function isLocal(character)
	return localPlayer ~= nil and character == localPlayer.Character
end

local function usesTracks()
	local a = Config.Animations
	return (a.StanceEnter or "") ~= "" and (a.StanceIdle or "") ~= "" and (a.StanceExit or "") ~= "" and (a.StanceMove or "") ~= ""
end

local function trackOf(character, key)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local cache = tracks[character]
	if not cache then
		cache = {}
		tracks[character] = cache
	end
	local tr = cache[key]
	if not tr then
		local animation = Instance.new("Animation")
		animation.AnimationId = Config.Animations[key]
		tr = animator:LoadAnimation(animation)
		tr.Priority = Enum.AnimationPriority.Movement
		tr.Looped = (key == "StanceIdle" or key == "StanceMove")
		cache[key] = tr
	end
	return tr
end

local function playTrack(character, key, fade)
	local tr = trackOf(character, key)
	if tr then
		tr:Play(fade or 0.1)
	end
end

local function stopTrack(character, key, fade)
	local cache = tracks[character]
	if cache and cache[key] then
		cache[key]:Stop(fade or 0.1)
	end
end

local function horizontalSpeed(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return 0
	end
	local v = hrp.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

-- visual enter / exit (any character) -------------------------------------------------

function Stance.isActive(character)
	local s = states[character]
	return s ~= nil and (s.phase == "enter" or s.phase == "hold")
end

function Stance.enter(character)
	local s = stateOf(character)
	if s.phase == "enter" or s.phase == "hold" then
		return
	end
	if usesTracks() then
		if not isLocal(character) then
			return -- the owner's tracks replicate to us
		end
		stopTrack(character, "StanceExit", 0.05)
		playTrack(character, "StanceEnter", 0.05)
	end
	s.phase, s.t, s.mt, s.blend, s.trackMoving = "enter", 0, 0, 0, false
	s.endsAt = os.clock() + Config.Stance.EnterTime
end

function Stance.exit(character)
	local s = stateOf(character)
	if s.phase == "off" or s.phase == "exit" then
		return
	end
	if usesTracks() then
		if not isLocal(character) then
			s.phase = "off"
			return
		end
		stopTrack(character, "StanceEnter", 0.05)
		stopTrack(character, "StanceIdle", 0.1)
		stopTrack(character, "StanceMove", 0.1)
		playTrack(character, "StanceExit", 0.1)
	end
	s.phase, s.t = "exit", 0
	s.endsAt = os.clock() + Config.Stance.ExitTime
end

-- local player actions ----------------------------------------------------------------

local function tell(on)
	if request then
		request:FireServer("Stance", { on = on })
	end
end

local function setActive(character, on)
	if on then
		Stance.enter(character)
	else
		Stance.exit(character)
	end
	tell(on)
end

-- Call on every local combat action (attack, block, dodge): enters the stance if enabled
-- and restarts the relax timer.
function Stance.engage()
	local character = localPlayer and localPlayer.Character
	if not character or not Config.Stance.Enabled then
		return
	end
	local s = stateOf(character)
	s.lastAction = os.clock()
	if Config.Stance.AutoEnter and (s.phase == "off" or s.phase == "exit") then
		setActive(character, true)
	end
end

-- Call when something happens that should keep the stance alive without entering it (getting hit).
function Stance.bump()
	local character = localPlayer and localPlayer.Character
	if character then
		stateOf(character).lastAction = os.clock()
	end
end

-- Toggle key: hold the stance until toggled off.
function Stance.toggle()
	local character = localPlayer and localPlayer.Character
	if not character or not Config.Stance.Enabled then
		return
	end
	local s = stateOf(character)
	if Stance.isActive(character) then
		s.locked = false
		setActive(character, false)
	else
		s.locked = true
		s.lastAction = os.clock()
		setActive(character, true)
	end
end

-- Sprinting (or anything else that should end the stance outright).
function Stance.dismiss()
	local character = localPlayer and localPlayer.Character
	if not character then
		return
	end
	local s = stateOf(character)
	s.locked = false
	if Stance.isActive(character) then
		setActive(character, false)
	end
end

-- per-frame -------------------------------------------------------------------------------

local function stepProcedural(character, s, dt)
	local rot
	if s.phase == "enter" then
		local anim = Data.STANCE_ENTER
		s.t += dt
		rot = sample(anim, s.t)
		if s.t >= anim.duration then
			s.phase, s.t = "hold", 0
		end
	elseif s.phase == "hold" then
		local idleAnim, moveAnim = Data.STANCE_IDLE, Data.STANCE_MOVE
		s.t = (s.t + dt) % idleAnim.duration
		local target = horizontalSpeed(character) > Config.Stance.MoveSpeedThreshold and 1 or 0
		s.blend += (target - s.blend) * (1 - math.exp(-Config.Stance.BlendSpeed * dt))
		rot = sample(idleAnim, s.t)
		if s.blend > 0.001 then
			s.mt = (s.mt + dt) % moveAnim.duration
			local move = sample(moveAnim, s.mt)
			for _, joint in ipairs(UPPER) do
				rot[joint] = rot[joint]:Lerp(move[joint], s.blend)
			end
			for _, joint in ipairs(HIPS) do
				rot[joint] = rot[joint]:Lerp(IDENTITY, s.blend) -- legs belong to the walk animation
			end
		end
	else -- exit
		local anim = Data.STANCE_EXIT
		s.t += dt
		rot = sample(anim, s.t)
		if s.t >= anim.duration then
			s.phase = "off"
			Poses.setBase(character, nil)
			if not Poses.isBusy(character) then
				Poses.release(character)
			end
			return
		end
	end

	local keyed = toMotorKeys(rot)
	-- Attacks recover toward wherever the stance currently is, so keep the base current.
	Poses.setBase(character, keyed)
	if not Poses.isBusy(character) then
		Poses.applyRotations(character, keyed)
	end
end

local function stepTracks(character, s)
	local now = os.clock()
	if s.phase == "enter" then
		if now >= s.endsAt then
			s.phase = "hold"
			stopTrack(character, "StanceEnter", 0.1)
			playTrack(character, "StanceIdle", 0.1)
		end
	elseif s.phase == "hold" then
		local moving = horizontalSpeed(character) > Config.Stance.MoveSpeedThreshold
		if moving ~= s.trackMoving then
			s.trackMoving = moving
			if moving then
				stopTrack(character, "StanceIdle", 0.15)
				playTrack(character, "StanceMove", 0.15)
			else
				stopTrack(character, "StanceMove", 0.15)
				playTrack(character, "StanceIdle", 0.15)
			end
		end
	elseif s.phase == "exit" then
		if now >= s.endsAt then
			s.phase = "off"
			stopTrack(character, "StanceExit", 0.1)
		end
	end
end

local function stepCharacter(character, s, dt)
	if isLocal(character) and s.phase == "hold" and not s.locked then
		if character:GetAttribute("Blocking") == true then
			s.lastAction = os.clock()
		elseif os.clock() - s.lastAction > Config.Stance.ExitDelay then
			setActive(character, false)
		end
	end
	if usesTracks() then
		if isLocal(character) then
			stepTracks(character, s)
		end
	else
		stepProcedural(character, s, dt)
	end
end

function Stance.step(dt)
	for character, s in pairs(states) do
		if s.phase ~= "off" then
			if character.Parent == nil then
				states[character] = nil
			else
				stepCharacter(character, s, dt)
			end
		end
	end
end

-- other players ---------------------------------------------------------------------------------

local function watchCharacter(character)
	if isLocal(character) then
		return -- the local player drives their own stance directly
	end
	local function sync()
		local want = character:GetAttribute("InStance") == true
		if want and not Stance.isActive(character) then
			Stance.enter(character)
		elseif not want and Stance.isActive(character) then
			Stance.exit(character)
		end
	end
	character:GetAttributeChangedSignal("InStance"):Connect(sync)
	sync()
end

local function watchPlayer(player)
	if player == localPlayer then
		return
	end
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
end

function Stance.init(remote)
	request = remote
	RunService.RenderStepped:Connect(Stance.step)
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
end

return Stance
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8">
			<Properties>
				<string name="Name">StanceData</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/StanceData (ModuleScript)
-- GENERATED by animations/export_extras.py from animations/stance.json - do not hand-edit.
-- Rotation-only keyframes the procedural stance plays until the real animation ids are set.
-- pose[joint] = {x, y, z} degrees, torso-space Rx*Ry*Rz (the same convention as Poses.lua).
-- ease = how the motion ARRIVES at that key. Torso translation and leg IK are not included.

return {
	STANCE_ENTER = { duration = 0.2667, loop = false, keys = {
		{ t = 0, ease = "Linear", pose = {
			Root = { 0, 0, 0 },
			Neck = { 0, 0, 0 },
			RightShoulder = { 0, 0, 0 },
			LeftShoulder = { 0, 0, 0 },
			RightHip = { 0, 0, 0 },
			LeftHip = { 0, 0, 0 },
		} },
		{ t = 0.0833, ease = "CubicOut", pose = {
			Root = { -20, -32, 0 },
			Neck = { 11.746, 31.458, -6.193 },
			RightShoulder = { -16.384, 30.943, -1.404 },
			LeftShoulder = { 62.08, 16.309, -17.92 },
			RightHip = { 35.51, 25.406, -4.274 },
			LeftHip = { 60.324, 18.548, -51.727 },
		} },
		{ t = 0.1667, ease = "CubicOut", pose = {
			Root = { -10, -22, 0 },
			Neck = { 5.39, 21.912, -2.017 },
			RightShoulder = { -19.312, 20.871, -2.883 },
			LeftShoulder = { 104.889, -5.927, -11.225 },
			RightHip = { 20.155, 19.67, 6.747 },
			LeftHip = { 34.908, 21.503, -24.792 },
		} },
		{ t = 0.2667, ease = "CubicInOut", pose = {
			Root = { -10, -20, 0 },
			Neck = { 4.256, 19.949, -1.454 },
			RightShoulder = { -8.506, 19.797, -5.1 },
			LeftShoulder = { 90, 0, -8 },
			RightHip = { 19.276, 17.945, 7.761 },
			LeftHip = { 32.582, 20.594, -19.458 },
		} },
	} },
	STANCE_IDLE = { duration = 3.2, loop = true, keys = {
		{ t = 0, ease = "CubicInOut", pose = {
			Root = { -10, -20, 0 },
			Neck = { 4.256, 19.949, -1.454 },
			RightShoulder = { -8.506, 19.797, -5.1 },
			LeftShoulder = { 90, 0, -8 },
			RightHip = { 19.276, 17.945, 7.761 },
			LeftHip = { 32.582, 20.594, -19.458 },
		} },
		{ t = 0.8, ease = "CubicInOut", pose = {
			Root = { -8.6, -20.4, 0.8 },
			Neck = { 4.51, 19.087, -2.319 },
			RightShoulder = { -3.33, 20.411, -8.588 },
			LeftShoulder = { 94.315, -2.4, -9.28 },
			RightHip = { 20.122, 17.805, 7.287 },
			LeftHip = { 33.291, 20.829, -20.015 },
		} },
		{ t = 1.6, ease = "CubicInOut", pose = {
			Root = { -10.8, -23.2, -0.8 },
			Neck = { 4.476, 24.792, -1.029 },
			RightShoulder = { -10.325, 22.743, -4.226 },
			LeftShoulder = { 88.437, 1.469, -10.169 },
			RightHip = { 26.098, 19.959, 7.483 },
			LeftHip = { 36.793, 23.722, -20.486 },
		} },
		{ t = 2.4, ease = "CubicInOut", pose = {
			Root = { -8.8, -17.5, 1.2 },
			Neck = { 4.496, 15.766, -2.493 },
			RightShoulder = { -4.026, 17.54, -6.932 },
			LeftShoulder = { 93.627, -2.34, -6.388 },
			RightHip = { 16.195, 15.691, 7.189 },
			LeftHip = { 31.825, 17.981, -19.329 },
		} },
		{ t = 3.2, ease = "CubicInOut", pose = {
			Root = { -10, -20, 0 },
			Neck = { 4.256, 19.949, -1.454 },
			RightShoulder = { -8.506, 19.797, -5.1 },
			LeftShoulder = { 90, 0, -8 },
			RightHip = { 19.276, 17.945, 7.761 },
			LeftHip = { 32.582, 20.594, -19.458 },
		} },
	} },
	STANCE_EXIT = { duration = 0.25, loop = false, keys = {
		{ t = 0, ease = "Linear", pose = {
			Root = { -10, -20, 0 },
			Neck = { 4.256, 19.949, -1.454 },
