<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties>
			<string name="Name">Combat</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">ClientEvents</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/ClientEvents (ModuleScript, client-side use)
-- Turns server broadcasts into poses, VFX, camera shake and local knockback.

local Players = game:GetService("Players")

local Combat = script.Parent
local Crater = require(Combat.Crater)
local Knockback = require(Combat.Knockback)
local Poses = require(Combat.Poses)
local VFX = require(Combat.VFX)

local ClientEvents = {}

local player = Players.LocalPlayer

local function myRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function shakeNear(position, radius, strength, duration)
	local root = myRoot()
	if not root then
		return
	end
	local distance = (root.Position - position).Magnitude
	if distance < radius then
		VFX.shake(strength * (1 - distance / radius), duration)
	end
end

function ClientEvents.connect(callbacks)
	local events = Combat:WaitForChild("CombatEvents")

	events.OnClientEvent:Connect(function(name, payload)
		payload = payload or {}
		local mine = payload.character ~= nil and payload.character == player.Character

		if name == "Pose" then
			-- Our own attacks/dodges/blocks were already played locally.
			if not (mine and payload.fromAttacker) then
				Poses.play(payload.character, payload.name)
			end
		elseif name == "PoseRelease" then
			if not mine then
				Poses.release(payload.character, payload.name)
			end
		elseif name == "Hit" then
			VFX.hit(payload.victim, payload.position, payload.kind, payload.direction)
		elseif name == "Impact" then
			Crater.spawn(payload.position, payload.normal, payload.material, payload.color, payload.intensity)
			shakeNear(payload.position, 70, 3.5 * (payload.intensity or 1), 0.4)
		elseif name == "Block" then
			VFX.block(payload.position)
		elseif name == "Parry" then
			VFX.parry(payload.position)
			shakeNear(payload.position, 30, 2, 0.2)
		elseif name == "GuardBreak" then
			VFX.guardBreak(payload.position)
			shakeNear(payload.position, 30, 2, 0.25)
		elseif name == "Dodge" then
			if not mine then
				VFX.dodge(payload.character)
			end
		elseif name == "Dodged" then
			VFX.afterimage(payload.victim, Color3.fromRGB(170, 220, 255))
		elseif name == "SlamStart" then
			if not mine then
				VFX.trail(payload.character, VFX.KindColors.Spike, 1.5)
			end
		elseif name == "Knockback" then
			if player.Character then
				Knockback.apply(player.Character, payload.velocity, payload.duration)
			end
		elseif name == "StopKnockback" then
			Knockback.stop(player.Character)
		elseif name == "Hurt" then
			VFX.shake(payload.kind == "Jab" and 1 or 2.5, 0.25)
			if callbacks.onHurt then
				callbacks.onHurt(payload)
			end
		elseif name == "HitConfirm" then
			if callbacks.onHitConfirm then
				callbacks.onHitConfirm(payload)
			end
		end
	end)
end

return ClientEvents
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Config (ModuleScript)
-- Every tunable number for the combat system lives here.

local Config = {}

Config.Debug = {
	ShowHitboxes = false,
}

Config.M1 = {
	ComboLength = 4,
	ComboResetTime = 1.1,
	SwingCooldown = 0.32,
	EndLag = 0.85,
	Windup = 0.11,
	Damage = { 3.5, 3.5, 4, 7 },
	HitboxSize = Vector3.new(5.5, 6, 5.5),
	HitboxOffset = 3.2,
	Lunge = 16,
	LungeTime = 0.09,
	HitStun = 0.55,
	FinisherStun = 0.9,
	FinisherKnockback = 70,
	FinisherLift = 14,
	JabPush = 7,
	AutoFaceRange = 11,
	AutoFaceAngle = 75,
}

Config.Air = {
	JuggleLift = 20,
	AttackerHang = 9,
}

Config.Uptilt = {
	Damage = 6,
	Launch = 70,
	LaunchTime = 0.16,
	Stun = 1.15,
	AttackerHop = 72,
	EndLag = 0.2,
}

Config.Slam = {
	MinHeight = 7,
	DiveVelocity = 140,
	SpikeDamage = 6,
	SpikeVelocity = 120,
	SpikeStun = 1.2,
	AoEDamage = 6,
	AoERadius = 10,
	AoEStun = 0.9,
	AoEKnockback = 45,
	AoELift = 32,
	EndLag = 0.6,
	HitboxSize = Vector3.new(7, 9, 7),
}

Config.Dodge = {
	Cooldown = 1.6,
	IFrames = 0.3,
	Speed = 90,
	Duration = 0.2,
	CanEscapeStun = false,
	DefaultDirection = "Forward",
}

Config.Block = {
	DamageMultiplier = 0.15,
	PerfectWindow = 0.16,
	ParryStun = 1.1,
	GuardBreakStun = 1.4,
	GuardBreakDamage = 4,
	MaxAngle = 75,
	Pushback = 10,
	ReleaseCooldown = 0.25,
}

Config.Impact = {
	MinSpeed = 35,
	WallSplatDamage = 3,
	WallSplatStun = 0.7,
	GroundBounce = 24,
	WatchTime = 0.7,
}

Config.Movement = {
	WalkSpeed = 16,
	SprintSpeed = 28,
	AttackingSpeed = 9,
	BlockingSpeed = 6,
	StunnedSpeed = 3,
	JumpPower = 50,
}

Config.Hit = {
	MaxTargets = 4,
	MaxValidationRange = 14,
	SlamValidationRange = 18,
	MinFacingDot = -0.35,
	-- false = players on the same Team (village) can't damage each other
	FriendlyFire = true,
}

-- Optional: paste real uploaded R6 animation ids here (e.g. "rbxassetid://123").
-- Any move left as "" falls back to the built-in procedural pose.
Config.Animations = {
	Jab1 = "",
	Jab2 = "",
	Jab3 = "",
	Finisher = "",
	Uptilt = "",
	SlamDive = "",
	SlamLand = "",
	Hurt = "",
	Block = "",
	Dodge = "",
	GuardBroken = "",
}

return Config
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Crater</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Crater (ModuleScript, client-side use)
-- Ground/wall impact: a ring of rubble that matches the surface's material and
-- color, flying debris chunks, a dust cloud and a shockwave disc. Works on any
-- surface orientation, so the same call makes floor craters and wall splats.

local Debris = game:GetService("Debris")

local VFX = require(script.Parent.VFX)

local Crater = {}

local rng = Random.new()

local function applyLook(p, material, color)
	pcall(function()
		p.Material = material
	end)
	p.Color = color
end

local function surfaceBasis(position, normal)
	local up = normal.Unit
	local ref = math.abs(up.Y) > 0.95 and Vector3.zAxis or Vector3.yAxis
	local right = ref:Cross(up).Unit
	return CFrame.fromMatrix(position, right, up)
end

local function rubbleRing(base, material, color, intensity)
	local count = math.floor(8 + 6 * intensity)
	local radius = 2.5 + 2.5 * intensity
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local scale = 0.8 + 0.35 * intensity
		local size = Vector3.new(rng:NextNumber(1.2, 2.3), rng:NextNumber(0.8, 1.7), rng:NextNumber(1.2, 2.3)) * scale
		local offset = Vector3.new(math.cos(angle) * radius, size.Y * 0.15, math.sin(angle) * radius)
		local final = base
			* CFrame.new(offset)
			* CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.6, 0.6))
		local rock = Instance.new("Part")
		rock.Anchored = true
		rock.CanCollide = false
		rock.CanQuery = false
		rock.CanTouch = false
		rock.Size = size
		rock.CFrame = final * CFrame.new(0, -size.Y * 1.5, 0)
		applyLook(rock, material, color)
		rock.Parent = VFX.folder()

		VFX.tween(rock, 0.14, { CFrame = final }, Enum.EasingStyle.Back)
		local linger = 2.5 + rng:NextNumber(0, 1)
		task.delay(linger, function()
			VFX.tween(rock, 0.6, { CFrame = final * CFrame.new(0, -size.Y * 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
		Debris:AddItem(rock, linger + 0.7)
	end
end

local function flyingDebris(position, base, material, color, intensity)
	local up = base.UpVector
	for _ = 1, math.floor(5 + 5 * intensity) do
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.one * rng:NextNumber(0.5, 1.1)
		chunk.CFrame = CFrame.new(position + up * 1.2) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		chunk.CanQuery = false
		chunk.CanTouch = false
		applyLook(chunk, material, color)
		chunk.Parent = VFX.folder()

		local tangent = (base.RightVector * rng:NextNumber(-1, 1) + base.LookVector * rng:NextNumber(-1, 1))
		tangent = tangent.Magnitude > 0 and tangent.Unit or base.RightVector
		chunk.AssemblyLinearVelocity = up * rng:NextNumber(30, 55) * intensity + tangent * rng:NextNumber(12, 30)
		chunk.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-15, 15), rng:NextNumber(-15, 15), rng:NextNumber(-15, 15))

		task.delay(1.6, function()
			VFX.tween(chunk, 0.5, { Transparency = 1 })
		end)
		Debris:AddItem(chunk, 2.2)
	end
end

function Crater.spawn(position, normal, material, color, intensity)
	intensity = math.clamp(intensity or 1, 0.4, 2.5)
	normal = (normal and normal.Magnitude > 0) and normal or Vector3.yAxis
	if material == nil or material == Enum.Material.Air then
		material = Enum.Material.Slate
	end
	color = color or Color3.fromRGB(110, 105, 100)

	local base = surfaceBasis(position, normal)
	rubbleRing(base, material, color, intensity)
	flyingDebris(position, base, material, color, intensity)

	VFX.burst(position + normal * 1, {
		texture = VFX.Textures.Smoke,
		color = Color3.fromRGB(175, 165, 150),
		count = math.floor(12 + 8 * intensity),
		speed = 16 * intensity,
		size = 3 * intensity,
		endSize = 6 * intensity,
		life = 0.9,
		light = 0,
		drag = 5,
		startTransparency = 0.3,
	})
	VFX.ring(position + normal * 0.2, normal, Color3.fromRGB(255, 245, 230), 2, 16 * intensity, 0.35)
	VFX.flashSphere(position, Color3.fromRGB(255, 240, 220), 6 * intensity, 0.18)
end

return Crater
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">Hitbox</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Hitbox (ModuleScript)
-- Spatial-query hitboxes that return living characters (players or NPCs).

local Config = require(script.Parent.Config)

local Hitbox = {}

local function characterFromPart(part)
	local parent = part.Parent
	if not parent then
		return nil
	end
	if parent:IsA("Accessory") then
		parent = parent.Parent
	end
	local humanoid = parent and parent:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return parent
	end
	return nil
end

local function collect(parts, origin)
	local seen, list = {}, {}
	for _, part in ipairs(parts) do
		local character = characterFromPart(part)
		if character and not seen[character] and character:FindFirstChild("HumanoidRootPart") then
			seen[character] = true
			table.insert(list, character)
		end
	end
	table.sort(list, function(a, b)
		return (a.HumanoidRootPart.Position - origin).Magnitude < (b.HumanoidRootPart.Position - origin).Magnitude
	end)
	local max = Config.Hit.MaxTargets
	while #list > max do
		table.remove(list)
	end
	return list
end

local function params(ignore)
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = ignore
	return op
end

function Hitbox.box(cframe, size, ignore)
	local parts = workspace:GetPartBoundsInBox(cframe, size, params(ignore))
	return collect(parts, cframe.Position)
end

function Hitbox.radius(position, radius, ignore)
	local parts = workspace:GetPartBoundsInRadius(position, radius, params(ignore))
	return collect(parts, position)
end

function Hitbox.debugDraw(cframe, size, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 0.7
	p.Color = color or Color3.fromRGB(255, 60, 60)
	p.Material = Enum.Material.ForceField
	p.Size = size
	p.CFrame = cframe
	p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 0.25)
end

function Hitbox.groundDistance(character, maxDistance)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return math.huge
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(hrp.Position, Vector3.new(0, -(maxDistance or 200), 0), rp)
	if not result then
		return math.huge, nil
	end
	-- HRP center sits 3 studs above the feet on an R6 rig
	return (hrp.Position - result.Position).Magnitude - 3, result
end

return Hitbox
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">Knockback</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Knockback (ModuleScript)
-- Shared by server (for NPCs it owns) and client (for its own character),
-- because a player's character physics are owned by that player's client.

local Knockback = {}

local NAME = "CombatKnockback"

local function rootOf(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

function Knockback.stop(character)
	local hrp = rootOf(character)
	if not hrp then
		return
	end
	local existing = hrp:FindFirstChild(NAME)
	if existing then
		existing:Destroy()
	end
end

function Knockback.apply(character, velocity, duration)
	local hrp = rootOf(character)
	if not hrp then
		return
	end
	Knockback.stop(character)

	local attachment = hrp:FindFirstChild("RootAttachment") or hrp:FindFirstChildWhichIsA("Attachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "RootAttachment"
		attachment.Parent = hrp
	end

	local lv = Instance.new("LinearVelocity")
	lv.Name = NAME
	lv.Attachment0 = attachment
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = math.huge
	lv.VectorVelocity = velocity
	lv.Parent = hrp

	hrp.AssemblyLinearVelocity = velocity

	task.delay(duration, function()
		if lv.Parent then
			lv:Destroy()
		end
	end)
	return lv
end

return Knockback
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">Poses</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/Poses (ModuleScript)
-- Procedural R6 attack/hurt poses, layered on top of the default Animate
-- script by tweening Motor6D.C0. If Config.Animations has a real id for a
-- move, that AnimationTrack is played instead.
-- Rotations are {x, y, z} radians in Torso space at the joint pivot:
--   +x swings a limb forward, +z swings a right limb outward (left limbs: -z),
--   Root +x leans the torso back, Root +y twists the torso left.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent.Config)

local Poses = {}

local MOTORS = {
	RS = { "Torso", "Right Shoulder" },
	LS = { "Torso", "Left Shoulder" },
	RH = { "Torso", "Right Hip" },
	LH = { "Torso", "Left Hip" },
	Neck = { "Torso", "Neck" },
	Root = { "HumanoidRootPart", "RootJoint" },
}

local H = math.pi / 2

Poses.Library = {
	Jab1 = { hold = 0.12, pose = { RS = { H, 0, 0 }, LS = { 0.8, 0, 0.3 }, Root = { -0.1, 0.45, 0 } } },
	Jab2 = { hold = 0.12, pose = { LS = { H, 0, 0 }, RS = { 0.8, 0, -0.3 }, Root = { -0.1, -0.45, 0 } } },
	Jab3 = { hold = 0.14, pose = { RS = { 1.3, 0, 0.9 }, LS = { 0.6, 0, 0.3 }, Root = { -0.15, 0.75, 0 } } },
	Finisher = {
		hold = 0.24,
		pose = { RH = { 1.75, 0, 0 }, LH = { -0.25, 0, 0 }, RS = { 0.4, 0, 0.8 }, LS = { 0.4, 0, -0.8 }, Root = { 0.3, 0.25, 0 } },
	},
	Uptilt = {
		hold = 0.28,
		pose = {
			RS = { 3.0, 0, 0.15 },
			LS = { 0.5, 0, -0.5 },
			RH = { -0.3, 0, 0 },
			LH = { 0.55, 0, 0 },
			Root = { 0.35, 0.3, 0 },
			Neck = { 0.35, 0, 0 },
		},
	},
	SlamDive = {
		hold = 1.6,
		pose = { RS = { 3.0, 0, 0 }, LS = { 3.0, 0, 0 }, RH = { 0.9, 0, 0 }, LH = { 0.9, 0, 0 }, Root = { -0.7, 0, 0 } },
	},
	SlamLand = {
		hold = 0.3,
		pose = { RS = { 1.0, 0, 0.3 }, LS = { 1.0, 0, -0.3 }, RH = { 0.9, 0, 0 }, LH = { -0.6, 0, 0 }, Root = { -0.5, 0, 0 } },
	},
	Hurt = {
		hold = 0.25,
		pose = { RS = { 0.4, 0, 0.6 }, LS = { 0.4, 0, -0.6 }, Root = { 0.35, 0, 0.1 }, Neck = { 0.4, 0, 0 } },
	},
	GuardBroken = {
		hold = 0.8,
		pose = { RS = { 0.6, 0, 1.4 }, LS = { 0.6, 0, -1.4 }, Root = { 0.45, 0, 0 }, Neck = { 0.5, 0, 0 } },
	},
	Block = {
		hold = math.huge,
		pose = { RS = { 1.6, 0, -0.7 }, LS = { 1.6, 0, 0.7 }, Root = { -0.12, 0, 0 }, Neck = { -0.1, 0, 0 } },
	},
	Dodge = {
		hold = 0.18,
		pose = { RS = { -0.5, 0, 0.3 }, LS = { -0.5, 0, -0.3 }, RH = { 0.6, 0, 0 }, LH = { -0.4, 0, 0 }, Root = { -0.45, 0, 0 } },
	},
}

local defaults = setmetatable({}, { __mode = "k" })
local tokens = setmetatable({}, { __mode = "k" })
local tracks = setmetatable({}, { __mode = "k" })

local function getMotor(character, key)
	local spec = MOTORS[key]
	local part = character:FindFirstChild(spec[1])
	return part and part:FindFirstChild(spec[2])
end

local function baseC0(motor)
	local base = defaults[motor]
	if not base then
		base = motor.C0
		defaults[motor] = base
	end
	return base
end

local function rotated(base, r)
	return CFrame.new(base.Position) * CFrame.Angles(r[1], r[2], r[3]) * base.Rotation
end

local function tweenC0(motor, goal, duration)
	TweenService:Create(motor, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = goal })
		:Play()
end

function Poses.usesTrack(name)
	local id = Config.Animations[name]
	return id ~= nil and id ~= ""
end

local function playTrack(character, name)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local cache = tracks[character]
	if not cache then
		cache = {}
		tracks[character] = cache
	end
	local track = cache[name]
	if not track then
		local animation = Instance.new("Animation")
		animation.AnimationId = Config.Animations[name]
		track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		cache[name] = track
	end
	track:Play(0.05)
end

function Poses.release(character, name)
	if not character then
		return
	end
	if name and Poses.usesTrack(name) then
		local cache = tracks[character]
		if cache and cache[name] then
			cache[name]:Stop(0.1)
		end
		return
	end
	tokens[character] = nil
	for key in pairs(MOTORS) do
		local motor = getMotor(character, key)
		if motor and defaults[motor] then
			tweenC0(motor, defaults[motor], 0.18)
		end
	end
end

function Poses.play(character, name, hold)
	local entry = Poses.Library[name]
	if not entry or not character then
		return
	end
	hold = hold or entry.hold

	if Poses.usesTrack(name) then
		-- A player's own client plays (and replicates) their tracks.
		local owner = Players:GetPlayerFromCharacter(character)
		if owner and owner ~= Players.LocalPlayer then
			return
		end
		playTrack(character, name)
		return
	end

	local token = {}
	tokens[character] = token
	for key in pairs(MOTORS) do
		local motor = getMotor(character, key)
		if motor then
			local base = baseC0(motor)
			local r = entry.pose[key]
			tweenC0(motor, r and rotated(base, r) or base, 0.07)
		end
	end

	if hold ~= math.huge then
		task.delay(0.07 + hold, function()
			if tokens[character] == token then
				Poses.release(character)
			end
		end)
	end
end

return Poses
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7">
			<Properties>
				<string name="Name">VFX</string>
				<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage/Combat/VFX (ModuleScript, client-side use)
-- Hit sparks, flashes, shockwave discs, afterimages, trails, camera shake.
-- Uses only built-in rbxasset:// textures, so nothing needs uploading.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local VFX = {}

VFX.Textures = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

VFX.KindColors = {
	Jab = Color3.fromRGB(255, 255, 255),
	Finisher = Color3.fromRGB(255, 190, 90),
	Uptilt = Color3.fromRGB(120, 205, 255),
	Spike = Color3.fromRGB(190, 120, 255),
	SlamAoE = Color3.fromRGB(190, 120, 255),
	WallSplat = Color3.fromRGB(255, 120, 80),
}

local rng = Random.new()
local folder

function VFX.folder()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "CombatVFX_Local"
		folder.Parent = workspace
	end
	return folder
end

function VFX.part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = VFX.folder()
	return p
end

function VFX.tween(instance, duration, goal, style, direction)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tw = TweenService:Create(instance, info, goal)
	tw:Play()
	return tw
end

function VFX.burst(position, opts)
	local life = opts.life or 0.3
	local speed = opts.speed or 20
	local holder = VFX.part({ Transparency = 1, Size = Vector3.one * 0.2, CFrame = CFrame.new(position) })
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder

	local pe = Instance.new("ParticleEmitter")
	pe.Texture = opts.texture or VFX.Textures.Spark
	pe.Color = ColorSequence.new(opts.color or Color3.new(1, 1, 1))
	pe.LightEmission = opts.light or 1
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, opts.size or 1),
		NumberSequenceKeypoint.new(1, opts.endSize or 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, opts.startTransparency or 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(life, life * 1.6)
	pe.Speed = NumberRange.new(speed, speed * 1.8)
	pe.SpreadAngle = opts.spread or Vector2.new(180, 180)
	pe.Acceleration = opts.accel or Vector3.zero
	pe.Drag = opts.drag or 4
	pe.Rate = 0
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-200, 200)
	if opts.direction then
		holder.CFrame = CFrame.lookAt(position, position + opts.direction) * CFrame.Angles(-math.pi / 2, 0, 0)
		pe.EmissionDirection = Enum.NormalId.Top
	end
	pe.Parent = attachment
	pe:Emit(opts.count or 15)
	Debris:AddItem(holder, life * 2 + 0.3)
end

function VFX.flashSphere(position, color, size, duration)
	local s = VFX.part({
		Shape = Enum.PartType.Ball,
		Color = color,
		Size = Vector3.one * size * 0.3,
		CFrame = CFrame.new(position),
		Transparency = 0.05,
	})
	VFX.tween(s, duration, { Size = Vector3.one * size, Transparency = 1 })
	Debris:AddItem(s, duration + 0.05)
end

-- Flat shockwave disc whose face points along `axis`.
function VFX.ring(position, axis, color, startSize, endSize, duration)
	axis = axis.Magnitude > 0 and axis.Unit or Vector3.yAxis
	local up = math.abs(axis.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
	local cf = CFrame.lookAt(position, position + axis, up) * CFrame.Angles(0, math.pi / 2, 0)
	local disc = VFX.part({
		Shape = Enum.PartType.Cylinder,
		Color = color,
		Transparency = 0.35,
		Size = Vector3.new(0.2, startSize, startSize),
		CFrame = cf,
	})
	VFX.tween(disc, duration, { Size = Vector3.new(0.05, endSize, endSize), Transparency = 1 })
	Debris:AddItem(disc, duration + 0.05)
end

function VFX.flashCharacter(character, color, duration)
	if not character then
		return
	end
	local hl = Instance.new("Highlight")
	hl.FillColor = color
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.FillTransparency = 0.2
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Adornee = character
	hl.Parent = VFX.folder()
	VFX.tween(hl, duration, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(hl, duration + 0.05)
end

function VFX.afterimage(character, color)
	if not character then
		return
	end
	for i = 0, 2 do
		task.delay(i * 0.06, function()
			for _, p in ipairs(character:GetChildren()) do
				if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
					local ghost = VFX.part({ Size = p.Size, CFrame = p.CFrame, Color = color, Transparency = 0.45 })
					VFX.tween(ghost, 0.35, { Transparency = 1 })
					Debris:AddItem(ghost, 0.4)
				end
			end
		end)
	end
end

function VFX.trail(character, color, duration)
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1.6, 0)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1.6, 0)
	a1.Parent = hrp
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Lifetime = 0.25
	trail.FaceCamera = true
	trail.Parent = hrp
	task.delay(duration, function()
		trail.Enabled = false
		Debris:AddItem(trail, 0.3)
		Debris:AddItem(a0, 0.3)
		Debris:AddItem(a1, 0.3)
	end)
end

local shakes = {}
local shakeBound = false

function VFX.shake(intensity, duration)
	table.insert(shakes, { amount = intensity, duration = duration, start = os.clock() })
	if shakeBound then
		return
	end
	shakeBound = true
	RunService:BindToRenderStep("CombatShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		local total = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local alpha = (now - s.start) / s.duration
			if alpha >= 1 then
				table.remove(shakes, i)
			else
				total += s.amount * (1 - alpha)
			end
		end
		if total <= 0 then
			RunService:UnbindFromRenderStep("CombatShake")
			shakeBound = false
			return
		end
		local cam = workspace.CurrentCamera
		cam.CFrame = cam.CFrame
			* CFrame.new(rng:NextNumber(-1, 1) * total * 0.06, rng:NextNumber(-1, 1) * total * 0.06, 0)
			* CFrame.Angles(math.rad(rng:NextNumber(-1, 1) * total), math.rad(rng:NextNumber(-1, 1) * total), 0)
	end)
end

local baseFov
function VFX.fovPunch(amount, duration)
	local cam = workspace.CurrentCamera
	baseFov = baseFov or cam.FieldOfView
	cam.FieldOfView = baseFov + amount
	VFX.tween(cam, duration, { FieldOfView = baseFov })
end

-- Composite effects ---------------------------------------------------------

function VFX.hit(victim, position, kind, direction)
	local color = VFX.KindColors[kind] or Color3.new(1, 1, 1)
	local heavy = kind ~= "Jab"
	VFX.flashSphere(position, color, heavy and 7 or 4, heavy and 0.22 or 0.13)
	VFX.burst(position, {
		color = color,
		count = heavy and 30 or 12,
		speed = heavy and 50 or 28,
		size = heavy and 1.2 or 0.7,
		life = 0.25,
	})
	if heavy then
		VFX.ring(position, direction or Vector3.yAxis, color, 2, 14, 0.25)
	end
	if kind == "Uptilt" then
		VFX.burst(position - Vector3.new(0, 2.5, 0), {
			texture = VFX.Textures.Smoke,
			color = Color3.fromRGB(220, 235, 255),
			count = 10,
			speed = 35,
			size = 2.5,
			endSize = 4,
			life = 0.35,
			light = 0.3,
			direction = Vector3.yAxis,
			spread = Vector2.new(20, 20),
		})
	end
	VFX.flashCharacter(victim, color, heavy and 0.25 or 0.15)
end

function VFX.block(position)
	local c = Color3.fromRGB(150, 210, 255)
	VFX.flashSphere(position, c, 3.5, 0.12)
	VFX.burst(position, { color = c, count = 10, speed = 22, size = 0.6, life = 0.2 })
end

function VFX.parry(position)
	VFX.flashSphere(position, Color3.new(1, 1, 1), 10, 0.2)
	VFX.burst(position, { color = Color3.fromRGB(255, 220, 120), count = 35, speed = 55, size = 1, life = 0.3 })
	VFX.ring(position, Vector3.yAxis, Color3.fromRGB(255, 230, 150), 2, 18, 0.3)
end

function VFX.guardBreak(position)
	VFX.flashSphere(position, Color3.fromRGB(255, 70, 70), 8, 0.2)
	VFX.burst(position, { color = Color3.fromRGB(150, 210, 255), count = 25, speed = 45, size = 0.9, life = 0.4, accel = Vector3.new(0, -60, 0) })
end

function VFX.dodge(character)
	VFX.afterimage(character, Color3.fromRGB(170, 220, 255))
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		VFX.burst(hrp.Position - Vector3.new(0, 2.6, 0), {
			texture = VFX.Textures.Smoke,
			color = Color3.fromRGB(200, 195, 185),
			count = 8,
			speed = 10,
			size = 2,
			endSize = 3.5,
			life = 0.45,
			light = 0,
		})
	end
end

return VFX
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
