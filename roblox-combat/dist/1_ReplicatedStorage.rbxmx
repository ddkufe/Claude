		{ t = 0.3, ease = "CubicInOut", pose = {
			Root = { -9, -15, 0 },
			Neck = { 5.175, 14.942, -1.338 },
			RightShoulder = { -1.035, 14.998, -7.732 },
			LeftShoulder = { 82.269, 2.064, -4.861 },
		} },
		{ t = 0.6, ease = "CubicInOut", pose = {
			Root = { -8, -14, 0 },
			Neck = { 4.122, 13.965, -0.996 },
			RightShoulder = { -4.122, 13.965, -7.004 },
