# Copy this to .env in your project root and fill in real keys.
# Get keys from: kie.ai, fal.ai, wavespeed.ai
# (Only add GOOGLE_API_KEY if you choose to route a model directly through
# Google AI Studio instead of via fal.ai.)

KIE_API_KEY=your_key_here
FAL_KEY=your_key_here
WAVESPEED_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here

# Remember to add .env to your .gitignore.
